generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoxType {
  id          Int      @id
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  code        String   @unique
  Op          Op[]
}

model BlisterType {
  id          Int      @id
  name        String
  description String?
  slots       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boxTypeId   Int
  limitPerBox Int
  code        String   @unique
  Op          Op[]
}

model ProductType {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  code        String   @unique
  Op          Op[]
}

model Op {
  id                Int         @id
  code              String
  boxTypeId         Int
  blisterTypeId     Int
  productTypeId     Int
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  finishedAt        DateTime?
  quantityToProduce Int
  status            OpStatus    @default(PENDING)
  blister           BlisterType @relation(fields: [blisterTypeId], references: [id])
  box               BoxType     @relation(fields: [boxTypeId], references: [id])
  product           ProductType @relation(fields: [productTypeId], references: [id])
  OpBox             OpBox[]
}

model OpBox {
  id                 String         @id @default(cuid())
  opId               Int
  code               String
  createdAt          DateTime       @default(now())
  packedAt           DateTime?
  breakAuthorizerId  Int?
  barCode            String?
  barCodeGeneratedAt DateTime?
  status             OpBoxStatus    @default(PENDING)
  assignedDeviceId   String?
  assignedAt         DateTime?
  packedByUserId     String?
  packedByDeviceId   String?
  breakAuthorizer    Manager?       @relation(fields: [breakAuthorizerId], references: [id])
  op                 Op             @relation(fields: [opId], references: [id], onDelete: Cascade)
  packedByUser       User?          @relation("PackedByUser", fields: [packedByUserId], references: [id])
  OpBoxBlister       OpBoxBlister[]
}

model OpBoxBlister {
  id       String    @id @default(cuid())
  opBoxId  String
  quantity Int       @default(0)
  packedAt DateTime?
  code     String
  opBox    OpBox     @relation(fields: [opBoxId], references: [id], onDelete: Cascade)

  @@unique([opBoxId, code])
}

model Manager {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  password  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  OpBox     OpBox[]
}

model DeviceSession {
  id          String    @id @default(cuid())
  deviceId    String    @unique
  userId      String
  qrToken     String    @unique
  qrExpiresAt DateTime
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

enum OpStatus {
  PENDING
  COMPLETED
}

enum OpBoxStatus {
  PENDING
  PACKAGED
  PACKAGED_W_BREAK
}

enum UserRole {
  SUPERVISOR
  OPERADOR
}

enum ActivityActionType {
  BOX_PACKED
  BOX_BREAK_AUTHORIZED
  PRODUCT_CREATED
  PRODUCT_AUTHORIZED
  OP_STARTED
  OP_COMPLETED
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           UserRole        @default(OPERADOR)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  OpActivityLogs OpActivityLog[]
  packedBoxes    OpBox[]         @relation("PackedByUser")
  DeviceSessions DeviceSession[]
}

model OpActivityLog {
  id          String             @id @default(uuid())
  opId        Int
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  actionType  ActivityActionType
  description String
  details     Json?
  boxId       String?
  productId   Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([opId])
  @@index([userId])
  @@index([createdAt])
}
