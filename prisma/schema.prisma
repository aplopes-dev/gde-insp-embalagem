generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoxType {
  id          Int      @id
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  code        String   @unique
  Op          Op[]

  // Referência do usuário criador (auditoria)
  createdById Int?
  createdBy   User?    @relation(name: "BoxTypeCreatedBy", fields: [createdById], references: [id])
}

model BlisterType {
  id          Int      @id
  name        String
  description String?
  slots       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boxTypeId   Int
  limitPerBox Int
  code        String   @unique
  Op          Op[]

  // Referência do usuário criador (auditoria)
  createdById Int?
  createdBy   User?    @relation(name: "BlisterTypeCreatedBy", fields: [createdById], references: [id])
}

model ProductType {
  id          Int      @id
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Referência do usuário criador (auditoria)
  createdById Int?
  createdBy   User?    @relation(name: "ProductTypeCreatedBy", fields: [createdById], references: [id])

  Op Op[]
}

model OculosInstance {
  id         Int          @id @default(autoincrement())
  referencia String       @unique
  nome       String
  status     OculosStatus @default(ATIVO)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  Op Op[]
}

model Op {
  id                Int       @id
  code              String
  boxTypeId         Int
  blisterTypeId     Int
  productTypeId     Int
  status            OpStatus  @default(PENDING)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  finishedAt        DateTime?
  quantityToProduce Int

  // Usuário que iniciou/“bipou” a OP (auditoria)
  createdById Int?
  createdBy   User? @relation(name: "OpCreatedBy", fields: [createdById], references: [id])

  // Referência para a instância do óculos que inspecionou (ex.: rw-...)
  oculosInstanceId Int?
  oculosInstance   OculosInstance? @relation(fields: [oculosInstanceId], references: [id])

  product ProductType @relation(fields: [productTypeId], references: [id])
  box     BoxType     @relation(fields: [boxTypeId], references: [id])
  blister BlisterType @relation(fields: [blisterTypeId], references: [id])

  OpBox OpBox[]
}

model OpBox {
  id                String    @id @default(cuid())
  opId              Int
  code              String
  createdAt         DateTime  @default(now())
  packedAt          DateTime?
  breakAuthorizerId Int?      // legado (Manager) - manter por compatibilidade

  // Auditoria
  createdById   Int?
  createdBy     User?    @relation(name: "OpBoxCreatedBy", fields: [createdById], references: [id])
  finalizedById Int?
  finalizedBy   User?    @relation(name: "OpBoxFinalizedBy", fields: [finalizedById], references: [id])

  // Claim de caixa por estação (usada para evitar concorrência)
  claimedAt           DateTime?
  claimedByInstanceId String?

  barCode            String?
  barCodeGeneratedAt DateTime?
  status             OpBoxStatus    @default(PENDING)
  breakAuthorizer    Manager?       @relation(fields: [breakAuthorizerId], references: [id])
  op                 Op             @relation(fields: [opId], references: [id], onDelete: Cascade)
  OpBoxBlister       OpBoxBlister[]
}

model OpBoxBlister {
  id       String    @id @default(cuid())
  opBoxId  String
  quantity Int       @default(0)
  packedAt DateTime?
  code     String

  // Auditoria
  createdById Int?
  createdBy   User?  @relation(name: "OpBoxBlisterCreatedBy", fields: [createdById], references: [id])

  opBox    OpBox     @relation(fields: [opBoxId], references: [id], onDelete: Cascade)

  @@unique([opBoxId, code])
}

model Manager {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  password  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  OpBox     OpBox[]
}

enum OpStatus {
  PENDING
  COMPLETED
}

enum OpBoxStatus {
  PENDING
  PACKAGED
  PACKAGED_W_BREAK
}

// Status para instâncias de óculos
enum OculosStatus {
  ATIVO
  INATIVO
}


// Perfis de usuário do sistema
enum Role {
  OPERATOR
  SUPERVISOR
  ADMIN
}

// Usuários de aplicação (login por email)
model User {
  id        Int      @id @default(autoincrement())
  name      String?
  username  String   @unique
  password  String?
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campos para integração com JERP
  email String   @unique
  cargo String?

  // Relacionamentos opcionais (lado inverso não é obrigatório declarar)
  accounts  Account[]
  sessions  Session[]
  // Back-relations para autorias e auditoria
  boxTypesCreated      BoxType[]        @relation("BoxTypeCreatedBy")
  blisterTypesCreated  BlisterType[]    @relation("BlisterTypeCreatedBy")
  productTypesCreated  ProductType[]    @relation("ProductTypeCreatedBy")
  opsCreated           Op[]             @relation("OpCreatedBy")
  opBoxesCreated       OpBox[]          @relation("OpBoxCreatedBy")
  opBoxesFinalized     OpBox[]          @relation("OpBoxFinalizedBy")
  opBlistersCreated    OpBoxBlister[]   @relation("OpBoxBlisterCreatedBy")
  auditLogs            AuditLog[]       @relation("AuditUser")
  workSessions         WorkSession[]    @relation("WorkSessionUser")
}

// Modelos necessários para NextAuth (adapter Prisma)
model Account {
  id                 String @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        Int
  expires       DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// Auditoria de ações de usuário
model AuditLog {
  id        String   @id @default(cuid())
  userId    Int
  action    String   // ex.: CREATE_OP, UPDATE_PRODUCT_TYPE, FINALIZE_WITH_BREAK
  entity    String   // ex.: Op, ProductType, BoxType, BlisterType, OpBox
  entityId  String   // ID da entidade afetada
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user      User     @relation(name: "AuditUser", fields: [userId], references: [id])
}

// RBAC flexível (permissões configuráveis pelo Admin)
model Permission {
  id          Int    @id @default(autoincrement())
  name        String @unique // ex.: CAN_CREATE_PRODUCT_TYPE
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           Int   @id @default(autoincrement())
  role         Role
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
}

// Sessão de trabalho do operador (histórico)
model WorkSession {
  id        String   @id @default(cuid())
  userId    Int
  startedAt DateTime @default(now())
  endedAt   DateTime?
  notes     String?

  user      User     @relation(name: "WorkSessionUser", fields: [userId], references: [id])
}
